# ============================================================================
# Você Digital - Variáveis de Ambiente (EXEMPLO)
# Copie este arquivo para `.env` e configure os valores reais
# ============================================================================

# Chave mestra Fernet para criptografia de certificados
# IMPORTANTE: Esta chave DEVE ter 32 bytes (44 caracteres em base64 url-safe)
# Em produção, gere uma nova chave com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VOCE_DIGITAL_MASTER_KEY=y_S0M3_S3CR3T_K3Y_F0R_AES_256_ENC_SAMP=

# Caminho para biblioteca PKCS#11 do token A3 (opcional, somente se usar A3)
# Linux: /usr/lib/softhsm/libsofthsm2.so
# Windows: C:\Windows\System32\eps2003csp11.dll
# macOS: /usr/local/lib/softhsm/libsofthsm2.so
PYKCS11_LIBRARY_PATH=